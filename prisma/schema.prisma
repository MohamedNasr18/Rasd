generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Site {
  id        String     @id @default(uuid())
  url       String
  scans     Scan[]
  siteScans SiteScan[]
  createdAt DateTime   @default(now())
}

model SiteScan {
  id               String   @id @default(uuid())
  siteId           String
  site             Site     @relation(fields: [siteId], references: [id])
  status           String   @default("processing")
  averageScore     Int?
  pageCount        Int
  completedPages   Int      @default(0)
  siteLevelResults Json?
  aiReport         Json?
  reportStatus     String?  // null | "processing" | "completed" | "failed"
  scans            Scan[]
  conversations    Conversation[]
  createdAt        DateTime @default(now())
}

model Scan {
  id            String   @id @default(uuid())
  siteId        String
  site          Site     @relation(fields: [siteId], references: [id])
  siteScanId    String?
  siteScan      SiteScan? @relation(fields: [siteScanId], references: [id])
  url           String   @default("")
  score         Int
  results       Json
  triggeredBy   String   @default("scan") // "scan" | "agent_rescan"
  previousScanId String? 
  createdAt     DateTime @default(now())
}
model Conversation {
  id         String    @id @default(uuid())
  siteScanId String
  siteScan   SiteScan  @relation(fields: [siteScanId], references: [id])
  messages   Message[]
  createdAt  DateTime  @default(now())
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           String       // "user" | "assistant"
  content        String       @db.Text
  createdAt      DateTime     @default(now())
}