generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Site {
  id        String     @id @default(uuid())
  url       String
  scans     Scan[]
  siteScans SiteScan[]
  createdAt DateTime   @default(now())
}

model SiteScan {
  id               String   @id @default(uuid())
  siteId           String
  site             Site     @relation(fields: [siteId], references: [id])
  status           String   @default("processing")
  averageScore     Int?
  pageCount        Int
  completedPages   Int      @default(0)
  siteLevelResults Json?
  aiReport         Json?
  reportStatus     String?  // null | "processing" | "completed" | "failed"
  aiReportEn       Json?
  reportStatusEn   String?  // null | "processing" | "completed" | "failed"
  scans            Scan[]
  progress         PageProgress[]
  conversations    Conversation[]
  createdAt        DateTime @default(now())
}

// One row per page (plus one for the site-level job). Each seo-analysis worker
// writes only its own row, so the 3 concurrent workers never clobber each other.
model PageProgress {
  id         String   @id @default(uuid())
  siteScanId String
  siteScan   SiteScan @relation(fields: [siteScanId], references: [id], onDelete: Cascade)
  kind       String   @default("page") // "page" | "site"
  position   Int      @default(0) // discovery order; site row is -1
  url        String
  stage      String   @default("queued")
  score      Int?
  updatedAt  DateTime @updatedAt

  @@unique([siteScanId, kind, url])
  @@index([siteScanId])
}

model Scan {
  id            String   @id @default(uuid())
  siteId        String
  site          Site     @relation(fields: [siteId], references: [id])
  siteScanId    String?
  siteScan      SiteScan? @relation(fields: [siteScanId], references: [id])
  url           String   @default("")
  score         Int
  results       Json
  triggeredBy   String   @default("scan") // "scan" | "agent_rescan"
  previousScanId String? 
  analyzerVersion String? // bumped when check logic/thresholds change
  createdAt     DateTime @default(now())
}
model Conversation {
  id         String    @id @default(uuid())
  siteScanId String
  siteScan   SiteScan  @relation(fields: [siteScanId], references: [id])
  messages   Message[]
  createdAt  DateTime  @default(now())
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           String       // "user" | "assistant"
  content        String       @db.Text
  createdAt      DateTime     @default(now())
}